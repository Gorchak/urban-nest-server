PORT=10000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.upoqd.mongodb.net/urban-nest?retryWrites=true&w=majority&appName=Cluster0
# Alias kept for backward compatibility
MONGODB_URI=

# Frontend origin (Vercel deployment URL)
CLIENT_URL=https://your-app.vercel.app

# Auth0 / JWT
JWT_SECRET=your_jwt_secret_here

NODE_ENV=production

# Nova Poshta
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_SENDER_CITY_REF=
NOVA_POSHTA_SENDER_REF=
NOVA_POSHTA_SENDER_ADDRESS_REF=
NOVA_POSHTA_SENDER_CONTACT_REF=
NOVA_POSHTA_SENDER_PHONE=
NOVA_POSHTA_PAYER_TYPE=Recipient
NOVA_POSHTA_PAYMENT_METHOD=Cash
NOVA_POSHTA_CARGO_TYPE=Parcel
NOVA_POSHTA_SERVICE_TYPE=WarehouseWarehouse
NOVA_POSHTA_DEFAULT_WEIGHT=1
NOVA_POSHTA_DEFAULT_SEATS=1
